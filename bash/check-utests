_check_compiler_() {
    local CComp=$1 CFlags=$2
    make clean &&
        CC="$CComp" CFLAGS="$CFlags" make ahre && make clean &&
        CC="$CComp" CFLAGS="$CFlags" make run_tests &&
        for f in build/test_*; do "./$f" || return 1; done
}
_check_compiler_ clang && _check_compiler_ gcc && make clean
